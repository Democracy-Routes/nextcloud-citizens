# Settings for standalone mode. Copy to .env.standalone and edit.
# .env.standalone holds secrets: keep it out of git (it is in .gitignore).
# No quotes around values, no spaces around "=".

# Required. Must be exactly "standalone". Any other value stops startup with
# the log line mode_invalid.
CITIZENS_MODE=standalone

# Required. A long random secret. Create one with:  openssl rand -hex 32
# It signs the login cookies and encrypts stored API keys and QR tokens.
# If you change it, everyone is signed out and the stored API keys become
# unreadable (enter them again in Settings). Back it up.
APP_SECRET=

# Required. The address people type, with https and no trailing slash.
# The QR codes, invitation mails and the Secure cookie flag use it.
CITIZENS_PUBLIC_URL=https://citizens.example.org

# The address of your reverse proxy as the container sees it. Only requests
# from these addresses may set X-Forwarded-For. Comma-separated.
# Proxy on the same host, app published on 127.0.0.1: the container sees the
# proxy as the Docker network gateway, usually 172.18.0.1 (a compose network)
# or 172.17.0.1 (the default bridge). Find it with:
#   docker network inspect <project>_default --format '{{(index .IPAM.Config 0).Gateway}}'
# If your proxy reaches the app some other way, use the address the app sees.
# Empty: the direct peer is the client, and login rate limiting sees every
# visitor as the proxy.
CITIZENS_TRUSTED_PROXIES=172.18.0.1

# Mail for invitations and password resets. Forms:
#   smtp://user:pass@mail.example.org:587   STARTTLS, with login
#   smtps://user:pass@mail.example.org:465  implicit TLS
#   smtp://relay.internal:25                plain, for a local relay only
# Percent-encode special characters in the password (@ is %40).
# Empty: no mail is sent and no link is usable (the log shows it redacted).
# Then set passwords from the command line instead:
#   docker compose -f docker-compose.standalone.yml exec citizens \
#     python -m citizens.standalone set-password --username anna
CITIZENS_SMTP_URL=
# The sender address of those mails, for example Citizens <citizens@example.org>
CITIZENS_MAIL_FROM=

# First administrator. Used once, at startup, while no account exists.
# Remove both lines after the first start. An alternative is the command
# line: see docs/standalone.md.
CITIZENS_BOOTSTRAP_ADMIN_USER=
CITIZENS_BOOTSTRAP_ADMIN_PASSWORD=

# How many days a browser stays signed in. Default 14.
# CITIZENS_SESSION_DAYS=14

# How many transcription/analysis jobs run at once. Default 10.
# 1 runs them one after another.
# CITIZENS_JOB_WORKERS=10

# DEBUG, INFO, WARNING or ERROR. Default INFO.
# CITIZENS_LOG_LEVEL=INFO

# Host port for the container (read by docker-compose.standalone.yml and
# standalone-up.sh). Default 23000.
# CITIZENS_PORT=23000

# The built-in Vosk engine needs no variable here: switch it on in Settings.
# Give the container more memory for large models (mem_limit in the compose
# file).
